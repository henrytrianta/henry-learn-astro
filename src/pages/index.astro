---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container";
import SocialIcon from "../components/SocialIcon";
import Photos from "../components/Photos/Photos.astro";
import Article from "../components/Article";
import Newsletter from "../components/Newsletter";
import Resume from "../components/Resume";

const path = Astro.url.pathname;
const posts = await Astro.glob("./blog/*.md");

// sort post by date
const sortedPosts = posts.sort(
  (objA, objB) =>
    Number(new Date(objB.frontmatter.date)) -
    Number(new Date(objA.frontmatter.date))
);
---

<Layout title="Nuitte.">
  <Container class="mt-9">
    <div class="max-w-2xl">
      <h1
        class="text-4xl font-bold tracking-tight text-zinc-800 dark:text-zinc-100 sm:text-5xl"
      >
        Lorem ipsum dolor sit, amet consectetur adipisicing elit.
      </h1>
      <p class="mt-6 text-base text-zinc-600 dark:text-zinc-400">
        Lorem ipsum dolor sit amet, consectetur adipisicing elit. Velit ratione
        consectetur, debitis, facilis aliquid explicabo quo at aut libero vero
        deserunt aperiam. Accusantium animi harum ut, minima necessitatibus
        excepturi laudantium!
      </p>
      <div class="mt-6 flex gap-6">
        <SocialIcon />
      </div>
      <a
        id="button-gradient"
        href=""
        class="mt-6 py-8 px-16 inline-block relative overflow-hidden rounded-3xl"
      >
        <canvas id="gradient-canvas" class="absolute top-0 left-0"></canvas>
        TEST BUTTON
      </a>
    </div>
  </Container>
  <Photos />
  <Container class="mt-24 md:mt-28">
    <div
      class="mx-auto grid max-w-xl grid-cols-1 gap-y-20 lg:max-w-none lg:grid-cols-2"
    >
      <div class="flex flex-col gap-16">
        {
          sortedPosts.map((post) => {
            // inject url into frontmatter
            post.frontmatter.url = post.url;
            return <Article article={post.frontmatter} />;
          })
        }
      </div>
      <div class="space-y-10 lg:pl-16 xl:pl-24">
        <Newsletter />
        <Resume />
      </div>
    </div>
  </Container>
</Layout>

<script>
  import Gradient from "../utils/gradient.js";
  const canvas = document.getElementById("gradient-canvas");

  if (!canvas) {
    const gradient = new Gradient(canvas, {
      colors: ["#ffffff", "#f87171", "#f9a8d4", "#fef08a"],
      seed: Math.random(),
    });

    console.log(gradient);
  }
</script>

<style>
  #gradient-canvas {
    width: 100%;
    height: 100%;
  }
</style>
