---
import type { MarkdownInstance } from "astro";
import ArticleList from "../../components/ArticleList";
import Layout from "../../layouts/Layout.astro";
import LayoutSimple from "../../layouts/LayoutSimple";
import type { blog } from "../../types";

let articles = [] as MarkdownInstance<blog>[];

// test if the folder is not empty at first to avoid throw any error
const testIfFileExist = await import.meta.glob("./*.md");
const isEmpty = Object.keys(testIfFileExist).length === 0;

// if the folder is not empty and fully satisfied
if (!isEmpty) {
  articles = await Astro.glob("./*.md");
}

console.log(articles);
---

<Layout title="Blog">
  <LayoutSimple
    title="Writing on software design, company building, and the aerospace industry."
    intro="All of my long-form thoughts on programming, leadership, product design, and more, collected in chronological order."
  >
    <div
      class="md:border-l md:border-zinc-100 md:pl-6 md:dark:border-zinc-700/40"
    >
      <div class="flex max-w-3xl flex-col space-y-16">
        {
          articles.map((article) => {
            article.frontmatter.url = article.url;
            return <ArticleList article={article.frontmatter} />;
          })
        }
      </div>
    </div>
  </LayoutSimple>
</Layout>
