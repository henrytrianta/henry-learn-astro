---
import LayoutBlog from "./LayoutBlog";
import { Picture } from "@astrojs/image/components";
import Avatar from "../../assets/henry-char.png";
import Header from "../common/components/Header";
import Footer from "../common/components/Footer";
export interface Props {
  title: string;
}

let { title } = Astro.props;

// check if document is markdown
const isMd = Astro.props.frontmatter != undefined;

// if the title is not exist, try to find it on frontmatter content, if not let the title being empty
if (isMd) {
  title = Astro.props.frontmatter?.title || "";
}

// get pathname
const { pathname } = Astro.url;
const isHomepage = pathname === "/";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} - Henry Trianta</title>
  </head>
  <body class="flex h-full flex-col bg-zinc-50 dark:bg-black">
    <!-- global page separator -->
    <div class="fixed inset-0 flex justify-center sm:px-8">
      <div class="flex w-full max-w-7xl lg:px-8">
        <div
          class="w-full bg-white ring-1 ring-zinc-100 dark:bg-zinc-900 dark:ring-zinc-300/20"
        >
        </div>
      </div>
    </div>

    <!-- slot wrapper -->
    <div class="relative">
      <Header pathname={pathname} client:load>
        <Picture
          src={Avatar}
          sizes={isHomepage ? "4rem" : "2.25rem"}
          widths={isHomepage ? [64, 128] : [36, 72]}
          aspectRatio="1:1"
          format={"avif"}
          alt="Henry Trianta - Portrait"
          slot="image"
          class={`rounded-full bg-zinc-100 object-cover dark:bg-zinc-800 ${
            isHomepage ? "h-16 w-16" : "h-9 w-9"
          }`}
          loading={"eager"}
        />
      </Header>
      <main>
        {
          !isMd && (
            // slot for normal page
            <slot />
          )
        }
        {
          isMd && (
            <LayoutBlog frontmatter={Astro.props.frontmatter}>
              <slot />
            </LayoutBlog>
          )
        }
      </main>
      <Footer />
    </div>
  </body>
</html>

<style is:global>
  /* here put the global style */
</style>
