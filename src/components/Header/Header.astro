---
import Container from "../Container";
import Avatar from "./Avatar.astro";
import AvatarContainer from "./AvatarContainer.astro";
import NavigationDesktop from "./NavigationDesktop.astro";

const { pathname } = Astro.url;

const isHomePage = pathname === "/";
---

<header
  class="relative z-50 flex flex-col pointer-events-none"
  style={{
    height: "var(--header-height)",
    marginBottom: "var(--header-mb)",
  }}
>
  {
    isHomePage && (
      <>
        <div class="order-last mt-[calc(theme(spacing.16)-theme(spacing.3))]" />
        <Container
          class="top-0 order-last pt-3 -mb-3"
          style={{ position: "var(--header-position)" }}
        >
          <div class="relative">
            <AvatarContainer
              className="absolute left-0 transition-opacity origin-left top-3"
              props={{
                style: {
                  opacity: "var(--avatar-border-opacity, 0)",
                  transform: "var(--avatar-border-transform)",
                },
              }}
            />
            <Avatar
              large
              className="block w-16 h-16 origin-left"
              props={{
                style: {
                  transform: "var(--avatar-image-transform)",
                },
              }}
            />
          </div>
        </Container>
      </>
    )
  }
  <div class="top-0 z-10 pt-6" style={{ position: "var(--header-position)" }}>
    <Container>
      <div class="relative flex gap-4">
        <div class="flex flex-1">
          {
            !isHomePage && (
              <AvatarContainer>
                <Avatar />
              </AvatarContainer>
            )
          }
        </div>
        <div class="flex justify-end flex-1 md:justify-center">
          <!-- <MobileNavigation class="pointer-events-auto md:hidden" /> -->
          <NavigationDesktop
            props={{ class: "hidden pointer-events-auto md:block" }}
          />
        </div>
        <div class="flex justify-end md:flex-1">
          <div class="pointer-events-auto">
            <!-- <ModeToggle /> -->
          </div>
        </div>
      </div>
    </Container>
  </div>
</header>
{isHomePage && <div style={{ height: "var(--content-offset)" }} />}
