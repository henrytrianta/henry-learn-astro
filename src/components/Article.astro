<Card as="article">
  <Card.Title href={article.url}>
    {article.title}
  </Card.Title>
  <Card.Eyebrow as="time" date-time={article.date} decorate>
    {formatDate(article.date)}
  </Card.Eyebrow>
  <Card.Description>{article.summary}</Card.Description>
  <Card.Cta>Read article</Card.Cta>
</Card>
