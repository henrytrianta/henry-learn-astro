---
import ContainerInner from "./ContainerInner.astro";
import ContainerOuter from "./ContainerOuter.astro";

export interface Props {
  className?: string;
  props?: astroHTML.JSX.HTMLAttributes;
}

const { className = "", props = {} } = Astro.props;
---

<ContainerOuter className={className} props={props}>
  <ContainerInner>
    <slot />
  </ContainerInner>
</ContainerOuter>
